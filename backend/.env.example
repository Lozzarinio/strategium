# Copy this file to .env and fill in your values.

# PostgreSQL connection string (Neon serverless example):
# DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/strategium?sslmode=require
#
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strategium
DATABASE_URL=

# Comma-separated list of allowed CORS origins.
# Production: https://strategium.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
